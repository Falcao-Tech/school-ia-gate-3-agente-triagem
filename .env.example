# Token pessoal do GitHub: o MCP usa para ler e o agente usa para comentar (só depois da sua aprovação).
# Classic com escopos "repo" e "read:org".
GITHUB_TOKEN=ghp_...

# Como subir o MCP do seu Gate 2 (stdio). Publicado no npm privado:
MCP_ISSUES_COMMAND=npx
MCP_ISSUES_ARGS=-y @seu-usuario/mcp-issues
# Ou direto do clone local do Gate 2:
# MCP_ISSUES_COMMAND=node
# MCP_ISSUES_ARGS=/caminho/do/gate-2/dist/index.js

# Modelo com suporte a tool calling, por API compatível com OpenAI. Escolha UMA opção.
# Opção A: OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
CHAT_MODEL=openai/gpt-4o-mini
# Opção B: Ollama local (modelos pequenos investigam mal; prefira 7B ou maior)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# CHAT_MODEL=qwen2.5:7b

# Labels que o agente pode sugerir
LABELS=bug,frontend,backend,infra,banco,docs

# Máximo de rodadas de ferramenta antes de propor
MAX_PASSOS=6
